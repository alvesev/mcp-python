[Unit]
Description=MCP server - Python 3 interpreter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Started as root - the server reads the TLS key, then drops to MCP_USER itself.
WorkingDirectory=/var/lib/mcp-python
EnvironmentFile=/etc/mcp-python/mcp-python.conf
ExecStart=/var/lib/mcp-python/venv/bin/python /usr/lib/mcp-python/mcp-python.py
Restart=on-failure
RestartSec=5

# Hardening - a submitted code runs with the rights of this service.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
ProtectSystem=strict
ReadWritePaths=/var/lib/mcp-python/scratch
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
MemoryMax=1G
TasksMax=64

[Install]
WantedBy=multi-user.target
