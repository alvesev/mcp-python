# Run in the staged tree of 'make package-deb' ('chart/Makefile'),
# where this directory is 'debian' - see 'README.source'. Nothing to build:
# the files are taken as they are, by the list of 'install' ('dh_install').
#

export DH_VERBOSE=1
export DH_OPTIONS=-v

# The chart is a gzip-compressed archive already - 'xz' of
# 'dpkg-deb' would only take time.
DEB_DH_BUILDDEB_ARGS_DEFAULT := -- -Zgzip

# CDBS file: /usr/share/cdbs/1/rules/debhelper.mk
include /usr/share/cdbs/1/rules/debhelper.mk
